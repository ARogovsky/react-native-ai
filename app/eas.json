{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_ENV": "DEVELOPMENT",
        "EXPO_PUBLIC_DEV_API_URL": "https://api.e-lli.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_ENV": "DEVELOPMENT",
        "EXPO_PUBLIC_DEV_API_URL": "https://api.e-lli.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_ENV": "PRODUCTION",
        "EXPO_PUBLIC_PROD_API_URL": "https://api.e-lli.com"
      }
    },
    "e2e": {
      "comment": "Device Farm login check: store-signed (Device Farm re-signs the IPA) with a DEV Clerk key so +clerk_test/424242 works.",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_ENV": "PRODUCTION",
        "EXPO_PUBLIC_PROD_API_URL": "https://api.e-lli.com",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_bmVhdC1iYWJvb24tNDIuY2xlcmsuYWNjb3VudHMuZGV2JA"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6788465576",
        "appleTeamId": "3Q8MF8D9J4"
      }
    }
  }
}
